# Copia este archivo a ".env" (mismo directorio) y reemplaza cada valor real.
# .env NUNCA se sube a git (ver .gitignore) - por eso este archivo de ejemplo existe,
# para que quien despliegue sepa exactamente qué variables tiene que llenar.

# --- Dominios (para Caddy / HTTPS automático) ---
# El dominio donde va a vivir el panel para los asesores, ej: panel.heliteb.co
PANEL_DOMAIN=CHANGE_ME
# El dominio donde va a vivir la API .NET, ej: api.heliteb.co - lo usan tanto el
# navegador del panel (ver PUBLIC_PANEL_API_URL mas abajo) como InboxCRM/Kommo/n8n
# para los webhooks.
API_DOMAIN=CHANGE_ME

# --- Modelos de IA del agente ---
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=CHANGE_ME
# https://console.groq.com/keys (fallback si DeepSeek falla o se satura)
GROQ_API_KEY=CHANGE_ME

# --- Embeddings de búsqueda semántica del catálogo ---
# "ollama" (gratis, local, self-hosted) o "gemini" (de pago, ver GEMINI_API_KEY) -
# ambos conviven indexados a la vez para poder comparar cuál da mejores resultados
# antes de decidir cuál usar (ver Heliteb.Infrastructure/Embeddings/EmbeddingsOptions.cs).
EMBEDDINGS_PROVIDER=ollama
# https://aistudio.google.com/apikey - solo necesaria si EMBEDDINGS_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME

# --- WhatsApp / CRM ---
# InboxCRM (https://lumark.cloud) - Settings del workspace HELITEB -> API Keys
INBOXCRM_API_KEY=CHANGE_ME
# Kommo - si se usa ese canal en vez de/ademas de InboxCRM (ver KommoAdminController)
KOMMO_CHANNEL_SECRET=CHANGE_ME
# Secreto compartido que TU defines y que tambien se configura en Kommo al conectar
# el webhook - cualquier cadena larga y aleatoria sirve.
KOMMO_WEBHOOK_SHARED_SECRET=CHANGE_ME

# --- Seguridad del panel ---
# Clave para firmar los JWT de sesion del panel - genera una cadena aleatoria larga
# (32+ caracteres), por ejemplo con: openssl rand -base64 32
JWT_SIGNING_KEY=CHANGE_ME
# Origen(es) del panel permitidos por CORS (coma-separado si hay mas de uno), ej:
# https://panel.heliteb.co - si se deja vacio/sin definir, el API acepta cualquier
# origen (comodo en dev, no usar así en producción).
CORS_ALLOWED_ORIGINS=http://localhost:4321

# --- Base de datos ---
# Password de Postgres - genera un valor nuevo para producción, no reutilices
# el default de desarrollo. ej: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# --- Sincronización con n8n (sedes / garantías / recursos) ---
# Secreto compartido que TU defines (cadena aleatoria) - se usa en los workflows de
# n8n (n8n.heliteb.co) para poder llamar de vuelta a la API sin necesitar login.
N8N_SYNC_SECRET=CHANGE_ME

# URL del API .NET tal como la alcanza el NAVEGADOR (no la red interna de Docker).
# El panel (./Front) la incrusta en su JS de cliente durante el build.
PUBLIC_PANEL_API_URL=http://localhost:5090

# --- API del agente para otros sistemas (maquina a maquina) ---
# Clave que deben mandar en el header X-Api-Key quienes consuman
# POST /api/agente/mensaje (un CRM, un chat web, otro agente).
# Generala con: openssl rand -hex 32
# Si se deja vacia, ese endpoint responde 503 y queda deshabilitado.
AGENT_API_KEY=
