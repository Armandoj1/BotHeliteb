---
import { ClientRouter } from 'astro:transitions';

// Poppins is the product typeface, self-hosted so it never depends on a CDN.
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@/styles/global.css';

import { APP_NAME } from '@/constants/app';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Consola de operaciones asistidas por IA' } = Astro.props;
---

<!doctype html>
<html lang="es" data-sidebar="expanded">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · {APP_NAME}</title>

    <ClientRouter />

    <!--
      Runs before the first paint and again after every client-side swap, because
      swapping documents resets <html> attributes. Doing this here (instead of in
      React) is what keeps the theme, the collapsed rail and the session redirect
      free of any visible flash.
    -->
    <script is:inline>
      (() => {
        const read = (key, fallback) => {
          try {
            const raw = localStorage.getItem(key);
            return raw === null ? fallback : JSON.parse(raw);
          } catch {
            return fallback;
          }
        };

        const applyPreferences = () => {
          const root = document.documentElement;
          root.classList.toggle('dark', read('heliteb:theme', 'light') === 'dark');
          root.dataset.sidebar = read('heliteb:sidebar-collapsed', false) ? 'collapsed' : 'expanded';
        };

        /*
          Comprueba que el token siga VIGENTE, no solo que exista. Antes bastaba
          con que hubiera algo en localStorage: se pintaba el panel entero, y solo
          cuando el API contestaba 401 aparecía "Tu sesión expiró" con la pantalla
          ya cargada y sin forma de entrar. Leyendo el 'exp' del propio JWT, una
          sesión vencida manda al login antes del primer pintado.
        */
        const sesionVigente = () => {
          const sesion = read('heliteb:session', null);
          if (!sesion || typeof sesion.token !== 'string') return false;

          try {
            const base64 = sesion.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
            const binario = atob(base64);
            // TextDecoder y no atob a secas: el token lleva el nombre del asesor,
            // que puede traer tildes, y atob solo devuelve bytes.
            const bytes = Uint8Array.from(binario, (c) => c.charCodeAt(0));
            const datos = JSON.parse(new TextDecoder().decode(bytes));

            if (typeof datos.exp === 'number' && datos.exp * 1000 <= Date.now()) {
              localStorage.removeItem('heliteb:session');
              return false;
            }
          } catch {
            // Token ilegible: se trata como sesión inválida, no como válida.
            localStorage.removeItem('heliteb:session');
            return false;
          }

          return true;
        };

        const enforceSession = () => {
          const isPublicRoute = location.pathname.startsWith('/login');
          const hasSession = sesionVigente();

          if (!hasSession && !isPublicRoute) location.replace('/login');
          else if (hasSession && isPublicRoute) location.replace('/');
        };

        applyPreferences();
        enforceSession();

        if (!window.__helitebShellBound) {
          window.__helitebShellBound = true;
          document.addEventListener('astro:after-swap', () => {
            applyPreferences();
            enforceSession();
          });
        }
      })();
    </script>
  </head>

  <body>
    <slot />
  </body>
</html>
