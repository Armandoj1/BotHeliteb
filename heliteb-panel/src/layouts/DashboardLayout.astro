---
import '../styles/global.css';
import { PanelLeft } from 'lucide-react';
import Sidebar from '../components/Sidebar.astro';
import ProductDrawer from '../components/ProductDrawer.tsx';

interface Props {
  title?: string;
}
const { title = 'HELITEB Panel' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // Aplica el estado guardado ANTES de pintar el body, para que no se vea un
      // parpadeo del sidebar abriendose/cerrandose en cada carga de pagina.
      if (localStorage.getItem('heliteb_sidebar_hidden') === '1') {
        document.documentElement.classList.add('sidebar-hidden');
      }
    </script>
  </head>
  <body>
    <button id="sidebar-toggle" class="sidebar-toggle-btn" title="Mostrar/ocultar menú" aria-label="Mostrar/ocultar menú">
      <PanelLeft size={16} />
    </button>
    <div class="dashboard-shell">
      <Sidebar />
      <div class="dashboard-content">
        <main class="dashboard-main">
          <slot />
        </main>
      </div>
    </div>
    <ProductDrawer client:load />
    <script is:inline>
      function setSidebarHidden(hidden) {
        document.documentElement.classList.toggle('sidebar-hidden', hidden);
        localStorage.setItem('heliteb_sidebar_hidden', hidden ? '1' : '0');
      }
      document.getElementById('sidebar-toggle')?.addEventListener('click', () => setSidebarHidden(false));
      document.getElementById('sidebar-hide')?.addEventListener('click', () => setSidebarHidden(true));
    </script>
  </body>
</html>
